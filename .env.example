PORT=3001

# Configuração do MySQL local iniciado por database/docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=projeto_denuncia
DB_CONNECTION_LIMIT=10

# Chave usada apenas na comunicação servidor -> servidor.
POLICIA_API_KEY=desenvolvimento-local

# Em desenvolvimento local, o painel pode acessar o backend diretamente.
PAINEL_ORIGIN=*

# Ative somente se estiver atrás de proxy reverso confiável.
TRUST_PROXY=false

EMERGENCIA_RATE_LIMIT=30
